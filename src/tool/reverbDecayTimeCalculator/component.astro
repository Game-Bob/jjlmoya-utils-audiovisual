---
import './reverb-decay-time-calculator.css';
import { reverbDecayTimeCalculator } from './entry';
import type { KnownLocale } from '../../types';
import { DEFAULT_UI_EN } from './ui';

interface Props { locale?: KnownLocale; }
const { locale = 'en' } = Astro.props;
const content = await reverbDecayTimeCalculator.i18n[locale]?.();
const ui = content?.ui ?? DEFAULT_UI_EN;
---

<section
  class="reverb-tool"
  data-reverb-tool
  data-statustoodry={ui.statusTooDry}
  data-statusontarget={ui.statusOnTarget}
  data-statustoowet={ui.statusTooWet}
  data-advicetoodry={ui.adviceTooDry}
  data-adviceontarget={ui.adviceOnTarget}
  data-advicetoowet={ui.adviceTooWet}
  data-readingtoodry={ui.statusTooDry}
  data-readingontarget={ui.statusOnTarget}
  data-readingtowet={ui.statusTooWet}
  data-target-range-template={ui.targetRangeTemplate}
  data-unit-volume-imperial={ui.unitVolumeImperial}
  data-unit-sabins-imperial={ui.unitSabinsImperial}
>
  <div class="reverb-layout">
    <form class="reverb-panel" data-reverb-form>
      <div class="reverb-panel-heading">
        <span>01</span>
        <strong>{ui.volumeLabel}</strong>
        <button type="button" class="reverb-reset" data-reset>{ui.resetLabel}</button>
      </div>
      <div class="reverb-unit-field">
        <span>{ui.unitSystemLabel}</span>
        <div class="reverb-unit-toggle" role="group" aria-label={ui.unitSystemLabel}>
          <button type="button" data-unit-option="metric" aria-pressed="true">{ui.unitMetric}</button>
          <button type="button" data-unit-option="imperial" aria-pressed="false">{ui.unitImperial}</button>
        </div>
      </div>
      <label class="reverb-field">
        <span>{ui.volumeLabel}<small>{ui.volumeHint}</small></span>
        <div class="reverb-input-wrap"><input name="volume" type="number" min="1" max="10000" step="1" value="120" required /><b data-volume-unit>{ui.unitVolume}</b></div>
      </label>
      <label class="reverb-field">
        <span>{ui.absorptionLabel}<small>{ui.absorptionHint}</small></span>
        <div class="reverb-input-wrap"><input name="absorption" type="number" min="0.1" max="10000" step="0.1" value="24" required /><b data-absorption-unit>{ui.unitSabins}</b></div>
      </label>
      <label class="reverb-field">
        <span>{ui.bpmLabel}<small>{ui.bpmHint}</small></span>
        <div class="reverb-input-wrap"><input name="bpm" type="number" min="20" max="300" step="1" value="120" required /><b>{ui.unitBpm}</b></div>
      </label>
      <div class="reverb-field">
        <span>{ui.targetLabel}<small>{ui.targetRangeTemplate.replace('__MIN__', '0.40').replace('__MAX__', '0.80')}</small></span>
        <div class="reverb-custom-select">
          <input type="hidden" name="target" value="vocals" data-target-value />
          <button type="button" class="reverb-select-trigger" data-target-trigger aria-label={ui.targetLabel} aria-haspopup="listbox" aria-expanded="false" aria-controls="reverb-target-options">
            <span data-target-label>{ui.targetVocals}</span><span class="reverb-select-chevron" aria-hidden="true"></span>
          </button>
          <div id="reverb-target-options" class="reverb-select-menu" data-target-menu role="listbox" hidden>
            <button type="button" role="option" data-target-option="speech" aria-selected="false">{ui.targetSpeech}</button>
            <button type="button" role="option" data-target-option="podcast" aria-selected="false">{ui.targetPodcast}</button>
            <button type="button" role="option" data-target-option="vocals" aria-selected="true">{ui.targetVocals}</button>
            <button type="button" role="option" data-target-option="acoustic" aria-selected="false">{ui.targetAcoustic}</button>
            <button type="button" role="option" data-target-option="orchestral" aria-selected="false">{ui.targetOrchestral}</button>
            <button type="button" role="option" data-target-option="ambient" aria-selected="false">{ui.targetAmbient}</button>
          </div>
        </div>
      </div>
      <div class="reverb-formula"><span>{ui.formulaLabel}</span><small>{ui.assumptionLabel}</small></div>
    </form>

    <div class="reverb-output">
      <div class="reverb-result-head">
        <div><span class="reverb-kicker">02 / RT60</span><h2>{ui.curveTitle}</h2></div>
        <div class="reverb-reading"><span class="reverb-status-dot" data-status-dot></span><span data-status aria-live="polite"></span></div>
      </div>
      <div class="reverb-chart-wrap">
        <svg class="reverb-chart" viewBox="0 0 640 210" role="img" aria-labelledby="reverb-chart-title">
          <title id="reverb-chart-title">{ui.curveTitle}</title>
          <line x1="10" y1="16" x2="10" y2="176" class="reverb-axis" />
          <line x1="10" y1="176" x2="630" y2="176" class="reverb-axis" />
          <rect data-target-band class="reverb-target-band" x="100" y="16" width="80" height="160" rx="8" />
          <path data-decay-path class="reverb-decay-path" d="M10 16 L630 176" />
          <text x="18" y="31" class="reverb-chart-label">0 dB</text>
          <text x="18" y="171" class="reverb-chart-label">-60 dB</text>
          <text x="630" y="198" text-anchor="end" class="reverb-chart-label" data-chart-max>4 s</text>
          <text x="98" y="198" class="reverb-chart-label">{ui.curveDrop}</text>
        </svg>
      </div>
      <p class="reverb-advice" data-advice aria-live="polite"></p>
      <div class="reverb-metrics">
        <div><span>{ui.resultRt60}</span><strong data-result-rt60></strong></div>
        <div><span>{ui.resultTarget}</span><strong data-result-target></strong></div>
        <div><span>{ui.resultPreDelay}</span><strong data-result-predelay></strong></div>
        <div><span>{ui.resultAbsorption}</span><strong data-result-absorption></strong></div>
      </div>
      <p class="reverb-target-range" data-target-range></p>
      <span class="reverb-sr-only" data-result-reading aria-live="polite"></span>
    </div>
  </div>
</section>

<script>
  import { mountReverbDecayCalculator } from './controller';
  const root = document.querySelector<HTMLElement>('[data-reverb-tool]');
  if (root) mountReverbDecayCalculator(root);
</script>
